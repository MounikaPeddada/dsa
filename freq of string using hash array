#include<bits/stdc++.h>
using namespace std;
int main()
{
    string s;
    cin>>s;
    int n=s.size();

    //pre compute
    int hash[27]={0};
    for(int i=0;i<n;i++)
    {
        hash[s[i]-'a']++;
    }

    int q;
    char c;
    cin>>q;
    while(q--)
    {
        cin>>c;
        cout<<hash[c-'a']<<endl;
    }
}
