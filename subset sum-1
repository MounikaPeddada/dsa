#include<bits/stdc++.h>
using namespace std;

void subsetsum(int ind,int sum,int n,int a[],vector<int>arr)
{
    if(ind==n)
    {
        arr.push_back(sum);
        return;
    }
    subsetsum(ind+1,sum+a[ind],n,a,arr); //pick
    subsetsum(ind+1,sum,n,a,arr); //not pick

}
int main()
{
    int n;
    cin>>n;
    int a[n];
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    vector<int>arr;
    int ind=0,sum=0;
    subsetsum(0,0,n,a,arr);
    sort(arr.begin(),arr.end());
    for(auto it : arr)
    {
        cout<<it<<" ";
    }
    cout<<endl;
}
