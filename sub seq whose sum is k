#include<bits/stdc++.h>
using namespace std;
void sub_seq_sum(int ind,vector<int>arr,int sum,int a[],int n,int s)
{
    if(ind==n)
    {
        if(sum==s)
        {
            for(auto it:arr)
            {
                cout<<it<<" ";
            }
            cout<<endl;
        }
        return;
    }
    arr.push_back(a[ind]);
    sum+=a[ind];
    sub_seq_sum(ind+1,arr,sum,a,n,s);
    arr.pop_back();
    sum-=a[ind];
    sub_seq_sum(ind+1,arr,sum,a,n,s);
}
int main()
{
    int n;
    cin>>n;
    int a[n];
    for(int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    vector<int>arr;
    int s,ind=0,sum=0;
    cin>>s;
    sub_seq_sum(0,arr,0,a,n,s);
}
