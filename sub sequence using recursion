#include<bits/stdc++.h>
using namespace std;
void sub_seq(int ind, vector<int>&arr,int a[],int n)
{
    if(ind==n)
    {
        if(arr.empty())
        {
            cout<<"{}";
        }
        for(auto it: arr) //it is int value(each element in vector)
        {
            cout<<it<<" ";
        }
        cout<<endl;
        return;
    }
    arr.push_back(a[ind]);
    sub_seq(ind+1,arr,a,n);
    arr.pop_back();
    sub_seq(ind+1,arr,a,n);
    
}
int main()
{
    int n;
    cin>>n;
    int a[n];
    for (int i=0;i<n;i++)
    {
        cin>>a[i];
    }
    vector<int>arr;
    int ind=0;
    sub_seq(0,arr,a,n);

}
